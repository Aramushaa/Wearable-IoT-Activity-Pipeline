          "rawQuery": true,
          "rawSql": "WITH activity_counts AS (\r\n  SELECT\r\n    predicted_label AS activity,\r\n    COUNT(*) AS prediction_count\r\n  FROM real_har_predictions\r\n  WHERE device = 'watch'\r\n    AND time >= $__timeFrom\r\n    AND time <= $__timeTo\r\n  GROUP BY predicted_label\r\n)\r\nSELECT\r\n  activity,\r\n  ROUND(\r\n    100.0 * prediction_count /\r\n    SUM(prediction_count) OVER (),\r\n    1\r\n  ) AS percentage\r\nFROM activity_counts\r\nORDER BY percentage DESC",
