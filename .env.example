# MQTT (used by ingest-service)
MQTT_HOST=emqx
MQTT_PORT=1883

# InfluxDB 3
INFLUX_ENABLED=1
INFLUX_HOST=http://influxdb3:8181
INFLUX_TOKEN=YOUR_TOKEN_HERE
INFLUX_DATABASE=tennis
INFLUX_TABLE=events_full_rows
INFLUX_IMU_TABLE=imu_raw_full_rows
INFLUX_WATCH_IMU_TABLE=watch_imu_clean
INFLUX_BATCH_SIZE=1000
INFLUX_FLUSH_INTERVAL_MS=300
INFLUX_MAX_QUEUE_SIZE=50000
INFLUX_WRITE_GENERIC_EVENTS=0

SUB_TOPICS=tennis/watch/clean,tennis/sensor/+/events,tennis/eeg/clean,tennis/ecg/clean

# Data cleaner service
CLEANER_MQTT_HOST=emqx
CLEANER_MQTT_PORT=1883
CLEANER_MQTT_CLIENT_ID=watch-cleaner-service
CLEANER_RAW_TOPIC=tennis/watch/raw
CLEANER_CLEAN_TOPIC=tennis/watch/clean
CLEANER_MQTT_QOS=1
CLEANER_MAX_PAIR_AGE_SECONDS=0.25

# Siddha sensor simulator
SIDDHA_MQTT_BROKER_HOST=emqx
SIDDHA_MQTT_BROKER_PORT=1883
SIDDHA_MQTT_TOPIC_PREFIX=tennis/sensor
SIDDHA_DATASET_PATH=/app/dataset/data.parquet
SIDDHA_REPLAY_MODE=fast
SIDDHA_REPLAY_SPEED=1.0
SIDDHA_DEFAULT_DEVICE_FILTER=
SIDDHA_DEFAULT_ACTIVITY_FILTER=
SIDDHA_DEFAULT_RECORDING_ID_FILTER=
SIDDHA_LOOP_FOREVER=false
SIDDHA_MQTT_QOS=1
SIDDHA_MQTT_WAIT_FOR_PUBLISH=true

# HAR 
HAR_INFLUX_HOST=http://influxdb3:8181
HAR_INFLUX_TOKEN=YOUR_TOKEN_HERE
HAR_INFLUX_DATABASE=tennis
HAR_IMU_TABLE=imu_raw_full_rows
HAR_PREDICTION_TABLE=real_har_predictions
HAR_INPUT_MODE=mqtt_stream
HAR_POLL_INTERVAL_SECONDS=5
HAR_MQTT_HOST=emqx
HAR_MQTT_PORT=1883
HAR_MQTT_TOPIC=tennis/watch/clean
HAR_MQTT_PREDICTION_TOPIC=tennis/watch/predictions
HAR_MQTT_QOS=1
HAR_MODEL_PATH=/app/model/L2MU_plain_leaky.onnx
HAR_LABELS_PATH=/app/model/labels.txt
HAR_QUERY_LIMIT=5000
HAR_WINDOW_SIZE=40
HAR_WINDOW_STRIDE=20
HAR_LIVE_WINDOW_STRIDE=1
HAR_LIVE_PERSISTENCE_INTERVAL_SECONDS=1.0
HAR_MAX_WINDOWS_PER_STREAM=0
HAR_FILTER_DEVICE=watch
HAR_ALLOWED_ACTIVITY_GT=
HAR_INPUT_LAYOUT=accel_then_gyro
HAR_TEMPORAL_PREPROCESS=none
HAR_SCORE_AGGREGATION=sum
HAR_MODEL_NAME=L2MU_plain_leaky

# MetaWear bridge
METAWEAR_MAC_ADDRESS=YOUR_MAC_ADDRESS_HERE
METAWEAR_DEVICE_NAME=watch
METAWEAR_RECORDING_ID=real_metawear_session_001
METAWEAR_MQTT_HOST=localhost
METAWEAR_MQTT_PORT=2883
METAWEAR_SAMPLING_RATE_HZ=25
METAWEAR_MQTT_TOPIC=tennis/watch/raw

# Phase 6 EEG/ECG dataset
EEG_DATASET_PATH=/app/dataset/openneuro_ds006848
EEG_SUBJECT=sub-001
EEG_TASK=verbalwm
EEG_MAX_SECONDS=600
EEG_REPLAY_SPEED=1.0
EEG_STARTUP_DELAY_SECONDS=5
EEG_MQTT_HOST=emqx
EEG_MQTT_PORT=1883
EEG_RAW_TOPIC=tennis/eeg/raw
EEG_CLEAN_TOPIC=tennis/eeg/clean
EEG_MQTT_QOS=1
EEG_CHANNEL_LIMIT=8
EEG_DOWNSAMPLE_HZ=100

ECG_DATASET_PATH=/app/dataset/openneuro_ds006848
ECG_SUBJECT=sub-001
ECG_TASK=verbalwm
ECG_MAX_SECONDS=600
ECG_REPLAY_SPEED=1.0
ECG_STARTUP_DELAY_SECONDS=5
ECG_MQTT_HOST=emqx
ECG_MQTT_PORT=1883
ECG_RAW_TOPIC=tennis/ecg/raw
ECG_CLEAN_TOPIC=tennis/ecg/clean
ECG_MQTT_QOS=1
ECG_DOWNSAMPLE_HZ=100

INFLUX_EEG_TABLE=eeg_clean
INFLUX_ECG_TABLE=ecg_clean

HAR_LIVE_WATCH_PREPROCESSING=true
